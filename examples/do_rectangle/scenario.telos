Source<MQTT> LocsysMQTT
    host: 'locsys.issel.ee.auth.gr'
    port: 8883
    ssl: true
    auth:
        username: 'sensors'
        password: 'issel.sensors'
end

Source<MQTT> HomeMQTT
    host: 'localhost'
    port: 1883
    auth:
        username: ''
        password: ''
end

Source<Redis> LocalRedis
    host: 'localhost'
    port: 6379
    auth:
        username: ''
        password: ''
end

Entity Robot1Pose
    type: sensor
    topic: 'gn_robot_1.pose.internal'
    source: LocalRedis
    attributes:
        - position: dict
        - orientation: dict
end

Goal<Circle> Goal_1
    center: Point3D(100, 5, 0)
    radius: 0.5
    tag: ENTER
    timeConstraints:
        - FROM_GOAL_START(<60)
end

Goal<Circle> Goal_2
    center: Point3D(100, 10, 0)
    radius: 0.5
    tag: ENTER
    timeConstraints:
        - FROM_GOAL_START(<60)
end

Goal<Circle> Goal_3
    center: Point3D(95, 10, 0)
    radius: 0.5
    tag: ENTER
    timeConstraints:
        - FROM_GOAL_START(<60)
end

Goal<Circle> Goal_4
    center: Point3D(95, 5, 0)
    radius: 0.5
    tag: ENTER
    timeConstraints:
        - FROM_GOAL_START(<60)
end

RTMonitor
    source: LocalRedis
    eventTopic: "goaldsl.{U_ID}.event"
    logsTopic: "goaldsl.{U_ID}.log"
end

Scenario DoRectangleScenario
    goals:
        - Goal_1
        - Goal_2
        - Goal_3
        - Goal_4
    concurrent: False
end
