Metadata
    name: YWdAS
    version: "0.1.0"
    author: "AUTHOR_NAME_HERE"
    email: "CONTACT_EMAIL_HERE"
    description: "BRIEF_DESCRIPTION"
end

Source<MQTT> LocsysMQTT
    host: 'locsys.issel.ee.auth.gr'
    port: 8883
    ssl: true
    auth:
        username: '*****'
        password: '*****'
end

Source<MQTT> LocalMQTT
    host: 'localhost'
    port: 1883
    auth:
        username: ''
        password: ''
end

Source<Redis> LocalRedis
    host: 'localhost'
    port: 6379
    auth:
        username: ''
        password: ''
end

RTMonitor
    source: LocalRedis
    eventTopic: "goaldsl.{U_ID}.event"
    logsTopic: "goaldsl.{U_ID}.log"
end

Entity AppVariables
    type: sensor
    topic: "appcreator.variables"
    source: LocalRedis
    freq: -1
    attributes:
        - name: str
        - value: str
        - type: str
end

Goal<Eval> CheckSum_1
    when
        "AppVariables.name == 'i' and int(AppVariables.value) == 10"
end

Goal<Eval> CheckSum_2
    when
        "AppVariables.name == 'i' and int(AppVariables.value) == 50"
end

Goal<Eval> CheckSum_3
    when
        "AppVariables.name == 'sum' and int(AppVariables.value) == 5050"
end

Scenario S1_T1
    goals:
        - CheckSum_1
        - CheckSum_2
        - CheckSum_3
    concurrent: False
end
