Broker<MQTT> HomeMQTT
    host: 'localhost'
    port: 1883
    auth:
        username: ''
        password: ''
end

Entity TempSensor1
    type: sensor
    source: HomeMQTT
    topic: 'bedroom.sensor.temperature'
    attributes:
        - temp: float
end


Goal<When> Goal_1
    when
        (TempSensor1.temp < 10) OR (TempSensor1.temp > 30)
end


Goal<When> Goal_2
    when
        (TempSensor1.temp < 10) OR (TempSensor1.temp > 30)
end

Goal<When> Goal_3
    when
        (TempSensor1.temp < 10) OR (TempSensor1.temp > 30)
end

Scenario E_1_G_3
    goals:
        - Goal_1
        - Goal_2
        - Goal_3
    concurrent: True
end
