Source<MQTT> HomeMQTT
    host: 'localhost'
    port: 1883
    auth:
        username: ''
        password: ''
end

Entity TempSensor1
    type: sensor
    source: HomeMQTT
    topic: 'bedroom.sensor.temperature'
    attributes:
        - temp: float
end

Entity TempSensor2
    type: sensor
    source: HomeMQTT
    topic: 'bedroom.sensor.temperature'
    attributes:
        - temp: float
end

Goal<When> Goal_1
    when
        (TempSensor1.temp < 10) OR (TempSensor1.temp > 30)
end

Goal<When> Goal_2
    when
        (TempSensor1.temp < 10) OR (TempSensor1.temp > 30)
end

Scenario E_2_G_2
    goals:
        - Goal_1
        - Goal_2
    concurrent: True
end
