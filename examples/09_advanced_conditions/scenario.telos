// =============================================================================
// Example 09: Advanced Conditions
// =============================================================================
// Demonstrates advanced condition features beyond basic comparisons.
//
// Covered:
//   - Aggregation functions: mean, std, var, min, max
//   - InRange condition
//   - GoalStatus condition (reference other goals' status)
//   - N-ary AND/OR (3+ operands, no parentheses needed)
//   - Binary logical: XOR, NOR, NAND, XNOR
//   - Mixed precedence with parentheses
// =============================================================================

Source<MQTT> LocalBroker
    host: 'localhost'
    port: 1883
    auth:
        username: ''
        password: ''
end

Entity TempSensor
    type: sensor
    topic: 'lab.sensor_a.temperature'
    source: LocalBroker
    attributes:
        - temp: float
        - humidity: float
end

Entity PressureSensor
    type: sensor
    topic: 'lab.sensor_b.pressure'
    source: LocalBroker
    attributes:
        - value: float
end

Entity AirQuality
    type: sensor
    topic: 'lab.air_quality'
    source: LocalBroker
    attributes:
        - co2: float
        - pm25: float
end

// --- Aggregation Functions ---

// Mean of the last 10 temperature readings must exceed 25.
Goal<When> MeanTempHigh
    when
        mean(TempSensor.temp, 10) > 25
end

// Standard deviation must be low (stable readings).
Goal<When> StableReadings
    when
        std(TempSensor.temp, 20) < 2.0
end

// Combined: mean above threshold AND variance below limit.
Goal<When> ConsistentHeat
    when
        mean(TempSensor.temp, 10) > 25 AND var(TempSensor.temp, 10) < 5.0
end

// Min and max over a sliding window.
Goal<When> TempRange
    when
        min(TempSensor.temp, 10) > 15 AND max(TempSensor.temp, 10) < 40
end

// --- InRange Condition ---

// Temperature must fall within a closed interval.
Goal<When> TempInBounds
    when
        TempSensor.temp in range [18.0, 26.0]
end

// --- GoalStatus Condition ---

// React based on the status of another goal.
Goal<When> AfterStableReadings
    when
        MeanTempHigh.status == REACHED
end

// --- N-ary AND/OR ---

// Three conditions combined with AND — no parentheses needed.
Goal<When> AllSensorsNominal
    when
        TempSensor.temp > 15 AND PressureSensor.value > 1 AND AirQuality.co2 < 1000
end

// Three conditions combined with OR.
Goal<When> AnyAlert
    when
        TempSensor.temp > 50 OR PressureSensor.value > 20 OR AirQuality.pm25 > 100
end

// --- Binary Logical Operators ---

// XOR: exactly one condition must be true.
Goal<When> ExclusiveAlert
    when
        (TempSensor.temp > 50) XOR (PressureSensor.value > 20)
end

// NAND: not both conditions true simultaneously.
Goal<When> NotBothCritical
    when
        (TempSensor.temp > 80) NAND (PressureSensor.value > 15)
end

// --- Mixed Precedence ---

// AND binds tighter than OR. This means:
//   (temp > 30 AND humidity > 60) OR (co2 > 800)
Goal<When> PrecedenceDemo
    when
        TempSensor.temp > 30 AND TempSensor.humidity > 60 OR AirQuality.co2 > 800
end

// Parentheses override natural precedence.
Goal<When> GroupedPrecedence
    when
        (TempSensor.temp > 30 OR AirQuality.co2 > 800) AND TempSensor.humidity < 80
end

// --- Scenario ---

Scenario AdvancedConditions
    goals:
        - MeanTempHigh
        - StableReadings
        - TempInBounds
        - AllSensorsNominal
        - ExclusiveAlert
    concurrent: true
end
