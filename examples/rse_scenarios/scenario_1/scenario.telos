Broker<MQTT> MyMQTTBroker
    host: 'localhost'
    port: 1883
    auth:
        username: ''
        password: ''
end

Entity TemperatureSensorList
    type: sensor
    topic: 'garden.temperature'
    source: MyMQTTBroker
    attributes:
        - regionA: float
        - regionB: float
        - regionC: float
        - regionD: float
end

Entity HumiditySensorList
    type: sensor
    topic: 'garden.humidity'
    source: MyMQTTBroker
    attributes:
        - regionA: float
        - regionB: float
        - regionC: float
        - regionD: float
end

Entity AirQualitySensorList
    type: sensor
    topic: 'garden.air_quality'
    source: MyMQTTBroker
    attributes:
        - regionA: float
        - regionB: float
        - regionC: float
        - regionD: float
end

Entity WindowRegionA
    type: actuator
    topic: 'garden.regionA.window'
    source: MyMQTTBroker
    attributes:
        - state: bool
end

Entity WindowRegionB
    topic: 'garden.regionB.window'
    source: MyMQTTBroker
    type: actuator
    attributes:
        - state: bool
end

Entity WindowRegionC
    type: actuator
    topic: 'garden.regionC.window'
    source: MyMQTTBroker
    attributes:
        - state: bool
end

Entity WindowRegionD
    type: actuator
    topic: 'garden.regionD.window'
    source: MyMQTTBroker
    attributes:
        - state: bool
end

// ------------------ GOAL Definitions -----------------
Goal<When> Goal_1
    when
        (TemperatureSensorList.regionA > 30) OR (HumiditySensorList.regionA > 0.8)
end

Goal<When> Goal_2
    when
        WindowRegionA.state is true
end

Goal<When> Goal_3
    when
        (TemperatureSensorList.regionA < 20) AND (HumiditySensorList.regionA < 0.8)
    config
        timeConstraints:
            - FROM_GOAL_START(<1800)
end

Goal<When> Goal_4
    when
        WindowRegionA.state is false
end

Goal<Cluster> CG1
    goals:
        - Goal_1
        - Goal_2
        - Goal_3
        - Goal_4
    strategy: ALL_ACCOMPLISHED_ORDERED
end

Goal<When> Goal_5
    when
        ((AirQualitySensorList.regionA < 0.5) OR (AirQualitySensorList.regionB < 0.5)) OR
        ((AirQualitySensorList.regionC < 0.5) OR (AirQualitySensorList.regionD < 0.5))
end

Goal<When> Goal_6
    when
        ((WindowRegionA.state is true) AND (WindowRegionB.state is true)) AND
        ((WindowRegionC.state is true) AND (WindowRegionD.state is true))
end

Goal<When> Goal_7
    when
        ((AirQualitySensorList.regionA > 0.8) AND (AirQualitySensorList.regionB > 0.8)) AND
        ((AirQualitySensorList.regionC > 0.8) AND (AirQualitySensorList.regionD > 0.8))
end

Goal<When> Goal_8
    when
        ((WindowRegionA.state is false) AND (WindowRegionB.state is false)) AND
        ((WindowRegionC.state is false) AND (WindowRegionD.state is false))
end

Goal<Cluster> CG2
    goals:
        - Goal_5 @0.2
        - Goal_6 @0.2
        - Goal_7 @0.3
        - Goal_8 @0.3
    strategy: ALL_ACCOMPLISHED_ORDERED
end

Scenario ScenarioA
    goals:
        - CG1
        - CG2
    concurrent: True
end
