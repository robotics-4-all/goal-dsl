import communication
import types
import utils

Entity:
    'Entity' name=ID
        (
		    ('type:' etype=EntityType)
		    ('topic:' topic=STRING)
            ('description:' description=STRING)?
		    ('freq:' freq=NUMBER)?
		    ('source:' source=EntitySource)
		    ('attributes:' '-' attributes*=Attribute['-'])
		)#
    'end'
;

EntityType:
    'sensor'    |
    'actuator'  |
    'hybrid'    |
    'robot'
;

// All valid primitive attribute data types — single source of truth in grammar
PrimitiveDataType:
    'int' | 'float' | 'str' | 'bool' | 'time' | 'list' | 'dict'
;

Attribute:
    name=ID ':' dtype=PrimitiveDataType
    ('=' default=AttributeDefault)?
    ('->' generator=ValueGen ('with noise' noise=Noise)?)?
;

// Time before FLOAT/INT to avoid INT greedily consuming HH in HH:MM
AttributeDefault:
    Time | List | DictDefault | FLOAT | INT | BOOL | STRING
;

DictDefault:
    '{' items*=Attribute[','] '}'
;

ValueGen:
    ConstantFun     |
    LinearFun       |
    SawFun          |
    GaussianFun     |
    SinusFun        |
    ReplayFun       |
    ReplayFileFun
;


GaussianFun:
    'gaussian' '(' value=NUMBER ',' maxValue=NUMBER ',' sigma=NUMBER ')'
;

SinusFun:
    'sinus' '(' dc=NUMBER ',' amplitude=NUMBER ',' step=NUMBER ')'
;

ConstantFun:
    'constant' '(' value=NUMBER ')'
;

LinearFun:
    'linear' '(' start=NUMBER ',' step=NUMBER ')'
;

SawFun:
    'saw' '(' min=NUMBER ',' max=NUMBER ',' step=NUMBER ')'
;

ReplayFun:
    'replay' '(' '[' values*=BASETYPE[','] ']' ',' times=INT ')'
;

ReplayFileFun:
    'replay' '(' filepath=STRING ')'
;


Noise: UniformNoise | GaussianNoise;

UniformNoise:
    'uniform' '(' min=NUMBER ',' max=NUMBER ')'
;

GaussianNoise:
    'gaussian' '(' mu=NUMBER ',' sigma=NUMBER ')'
;
