// FQN: ID('.'ID)*;
FQN: ID+['.'];
FQNI: ID+['.']('.*')?;
NID: /(.*?)\n/;
NIDREF: NID+['.']('.*')?;
Import: 'import' importURI=ImportPath;
ImportPath: STRING | /[a-zA-Z_]\w*(\.[a-zA-Z_]\w*)*/;


// Comments
Comment: CommentLine | CommentBlock ;
CommentLine: /\/\/.*?$/;
CommentBlock: /\/\*(.|\n)*?\*\//;

