import time_constraint
import types
import entity
import utils

TrajectoryGoal:
    StraightLineTrajectoryGoal  |
    WaypointTrajectoryGoal |
    CurveTrajectoryGoal
;

StraightLineTrajectoryGoal:
    'Goal<Trace>' name=ID
    (
        ('entity:' entity=[Entity:FQN|+pm:entities*])
        ('startPoint:' startPoint=Point)
        ('finishPoint:' finishPoint=Point)
        ('maxDeviation:' maxDeviation=NUMBER)
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('timeout:' timeout=FLOAT)?
        ('tags:' '[' tags*=ID[','] ']')?
    )#
    ('end' | ';')
;

WaypointTrajectoryGoal:
    'Goal<Route>' name=ID
    (
        ('entity:' entity=[Entity:FQN|+pm:entities*])
        ('points:' '[' points+=Point[','] ']')
        ('maxDeviation:' maxDeviation=NUMBER)
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('timeout:' timeout=FLOAT)?
        ('tags:' '[' tags*=ID[','] ']')?
    )#
    ('end' | ';')
;

CurveTrajectoryGoal:
    'Goal<Arc>' name=ID
    (
        ('entity:' entity=[Entity:FQN|+pm:entities*])
        ('startPoint:' startPoint=Point)
        ('finishPoint:' finishPoint=Point)
        ('curvature:' curvature=NUMBER)
        ('maxDeviation:' maxDeviation=NUMBER)
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('timeout:' timeout=FLOAT)?
        ('tags:' '[' tags*=ID[','] ']')?
    )#
    ('end' | ';')
;
