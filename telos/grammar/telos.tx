/*
    Telos
*/
import communication
import goal
import entity
import utils
import types
import time_constraint


TelosModel:
    imports*=Import
    (metadata=Metadata)?
    (
        (rtmonitor=RTMonitor)?
        (constants*=Constant)
        (brokers*=MessageBroker)
        (restEndpoints*=RESTEndpoint)
        (entities*=Entity)
        (goals*=Goal)
        (scenarios*=Scenario)
    )#
;

Constant: 'const' name=ID '=' value=ConstantValue;
ConstantValue: STRING | FLOAT | INT | BOOL;


Metadata:
    'Metadata'
    (
        ('name:' name=ID)
        ('version:' version=STRING)
        ('author:' author=STRING)?
        ('email:' email=STRING)?
        ('description:' description=STRING)?
    'end'
    )#
;

RTMonitor:
    'RTMonitor'
    (
        ('source:' source=EntitySource)
		('namespace:' ns=STRING)?
		('eventTopic:' eTopic=STRING)?
		('logsTopic:' lTopic=STRING)?
    'end'
    )#
;


Scenario:
    'Scenario' name=ID
    (
        ('goals:' '-' goals*=WeightedGoal['-'])
        ('antigoals:' '-' antigoals*=WeightedGoal['-'])?
        ('fatals:' '-' fatals*=[Goal:FQN|+m:goals*]['-'])?
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('concurrent:' concurrent=BOOL)?
        ('tickFreq:' goalTickFreqHz=NUMBER)?
        ('description:' description=STRING)?
        ('namespace:' ns=STRING)?
    )#
    'end'
;
