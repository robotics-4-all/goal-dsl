EntitySource:
    (ref=[MessageBroker])       |
    (ref=[RESTEndpoint])
;

MessageBroker:
    AMQPBroker | MQTTBroker | RedisBroker
;


Authentication: AuthPlain | AuthApiKey | AuthCert;

AuthPlain:
    'username' ':' username=STRING
    'password' ':' password=STRING
;

AuthApiKey:
    'key' ':' key=STRING
;

AuthCert:
    ('cert' ':' cert=STRING) | ('certPath' ':' certPath=STRING)
;

AMQPBroker:
    'Source<AMQP>' name=ID
    (
        ('host:' host=STRING)
        ('port:' port=INT)
        ('vhost:' vhost=STRING)?
        ('topicExchange:' topicE=STRING)?
        ('rpcExchange:' rpcE=STRING)?
        ('ssl' ':' ssl=BOOL)?
        ('auth' ':' auth=Authentication)?
    )#
    'end'
;

MQTTBroker:
    'Source<MQTT>' name=ID
    (
        ('host:' host=STRING)
        ('port:' port=INT)
        ('ssl' ':' ssl=BOOL)?
        ('basePath:' basePath=STRING)?
        ('webPath:' webPath=STRING)?
        ('webPort:' webPort=INT)?
        ('auth' ':' auth=Authentication)?
    )#
    'end'
;

RedisBroker:
    'Source<Redis>' name=ID
    (
        ('host:' host=STRING)
        ('port:' port=INT)
        ('db:' db=INT)?
        ('ssl' ':' ssl=BOOL)?
        ('auth' ':' auth=Authentication)?
    )#
    'end'
;


RESTEndpoint:
    'RESTEndpoint' name=ID
    (
        ('verb:' verb=RESTVerb)
        ('host:' host=STRING)
        ('port:' port=INT)
        ('path:' path=STRING)
        ('base_url:' baseUrl=STRING)?
        (
        'params:'
            ('query:' '-' queryParams*=Property['-'])?
            ('path:' '-' pathParams*=Property['-'])?
            ('body:' '-' bodyParams*=Property['-'])?
        ('headers:' '-' headers*=Property['-'])?
        )?
    )#
    'end'
;

RESTVerb:
    'GET'       |
    'POST'      |
    'PUT'       |
    'DELETE'
;

Property:
    name=ID ':' type=DataType
;

DataType:
    'int' | 'float' | 'str' | 'bool' | 'list' | 'dict' | 'time'
;
