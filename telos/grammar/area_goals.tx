import entity
import types
import time_constraint
import utils


AreaGoal:
    RectangleAreaGoal     |
    CircularAreaGoal      |
    StraightLine          |
    MovingAreaGoal        |
    PolylineAreaGoal
;


RectangleAreaGoal:
    'Goal<Rect>' name=ID
    (
        ('entities:' '-' entities+=[Entity:FQN|+pm:entities*]['-'])?
        ('bottomLeftEdge:' bottomLeftEdge=Point )
        ('lengthX:' lengthX=NUMBER)
        ('lengthY:' lengthY=NUMBER)
        ('tag:' tag=AreaGoalTag )
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('timeout:' timeout=FLOAT)?
        ('tags:' '[' tags*=ID[','] ']')?
    )#  // Any order
    'end'
;

PolylineAreaGoal:
    'Goal<Poly>' name=ID
    (
        ('entities:' '-' entities+=[Entity:FQN|+pm:entities*]['-'])?
        ('points:' '[' points+=Point[','] ']' )
        ('tag:' tag=AreaGoalTag )
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('timeout:' timeout=FLOAT)?
        ('tags:' '[' tags*=ID[','] ']')?
    )#  // Any order
    'end'
;

MovingAreaGoal:
    'Goal<Shadow>' name=ID
    (
        ('movingEntity:' entity=[Entity:FQN|+pm:entities*])
        ('entities:' '-' entities+=[Entity:FQN|+pm:entities*]['-'])?
        ('radius:' radius=NUMBER)
        ('tag:' tag=AreaGoalTag)
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('timeout:' timeout=FLOAT)?
        ('tags:' '[' tags*=ID[','] ']')?
    )#  // Any order
    'end'
;

CircularAreaGoal:
    'Goal<Circle>' name=ID
    (
        ('entities:' '-' entities+=[Entity:FQN|+pm:entities*]['-'])?
        ('center:' center=Point)
        ('radius:' radius=NUMBER)
        ('tag:' tag=AreaGoalTag)
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('timeout:' timeout=FLOAT)?
        ('tags:' '[' tags*=ID[','] ']')?
    )#
    'end'
;

StraightLine:
    'Goal<Line>' name=ID
    (
        ('entities:' '-' entities+=[Entity:FQN|+pm:entities*]['-'])?
        ('startPoint:' startPoint=Point)
        ('endPoint:' endPoint=Point)
        ('tag:' tag=AreaGoalTag)
        ('timeConstraints:' '-' timeConstraints*=TimeConstraint['-'])?
        ('timeout:' timeout=FLOAT)?
        ('tags:' '[' tags*=ID[','] ']')?
    )#
    'end'
;

AreaGoalTag: 'ENTER' | 'EXIT' | 'AVOID' | 'STEP' | 'STAY' | 'CROSS';
